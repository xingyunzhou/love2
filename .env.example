# 管理面板口令，面板登录用；留空 = 不校验（仅限本机）
ADMIN_TOKEN=change-me-admin

# /v1/* 转发口令，留空 = 不校验。公开部署建议设置，并在调用侧带 x-proxy-token
PROXY_TOKEN=

# 加密号池 api_key 的主口令，随便一串长随机值；改了这个值旧密钥会解不开
SECRET_KEY=please-change-this-to-a-long-random-string

# 数据目录（容器内固定 /data，本地跑可改）
DATA_DIR=data

# 日志保留条数
LOG_KEEP=3000

PORT=8000
TZ=Asia/Shanghai
